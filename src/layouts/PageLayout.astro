---
import SiteHeader from "$lib/components/SiteHeader.astro";
import "../styles/prose.css";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  summary: string;
  crumbs?: { label: string; href: string }[];
  meta?: string[];
}

const { title, summary, crumbs = [], meta = [] } = Astro.props;
const pageTitle = crumbs.length ? `${title} · ${crumbs.map((c) => c.label).join(" · ")}` : title;
---

<Layout title={pageTitle} description={summary}>
  <div class="text-page">
    <slot name="banner" />
    <header class="masthead grid-bg">
      <SiteHeader />
      <div class="wrap masthead-inner">
        {crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            {crumbs.map((c) => (
              <a href={c.href}>{c.label}</a>
            ))}
          </nav>
        )}
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
        {meta.length > 0 && (
          <p class="meta">
            {meta.map((m) => (
              <span>{m}</span>
            ))}
          </p>
        )}
      </div>
    </header>

    <main>
      <slot />
    </main>
  </div>
</Layout>

<style>
  .text-page {
    min-height: 100%;
    font-family: var(--brand-font);
    background: var(--cd-white);
    color: var(--brand-default-text-color);
  }
  .text-page :global(.wrap) {
    max-width: 1120px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }
  .masthead {
    border-bottom: 1px solid var(--cd-blue--lightest);
  }
  .masthead-inner {
    padding-top: 3rem;
    padding-bottom: 2.75rem;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }
  .crumbs a {
    color: var(--brand-primary--text);
    font-weight: 600;
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .crumbs a + a::before {
    content: "/";
    margin-right: 0.5rem;
    color: var(--brand-grey--text);
    font-weight: 400;
  }
  h1 {
    margin: 0 0 1rem;
    font-size: 2.6rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--brand-primary--text);
  }
  .lede {
    max-width: 52ch;
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--cd-grey--800);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
  }
  .meta span {
    padding: 0.2rem 0.7rem;
    border-radius: var(--brand-radius--pill);
    background: var(--brand-primary--lightest);
    color: var(--brand-primary--dark);
    font-size: 0.8rem;
    font-weight: 600;
  }
  @media (max-width: 700px) {
    h1 {
      font-size: 2rem;
    }
  }
</style>
