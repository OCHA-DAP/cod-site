---
import PageLayout from "./PageLayout.astro";

interface Props {
  title: string;
  summary: string;
  crumbs?: { label: string; href: string }[];
  meta?: string[];
}
---

<PageLayout {...Astro.props}>
  <aside slot="banner" class="wip" id="wip-banner" aria-label="Draft notice">
    <div class="wrap wip-inner">
      <span class="wip-badge">Draft</span>
      <p>
        These documents are a work in progress. They may change and do not yet represent agreed
        COD-AB policy.
      </p>
      <button type="button" class="wip-close" aria-label="Dismiss notice">
        &times;
      </button>
    </div>
  </aside>
  <script is:inline slot="banner">
    // Runs before first paint so a dismissed banner never flashes.
    const wip = document.getElementById("wip-banner");
    if (wip && localStorage.getItem("standards-wip-dismissed")) wip.hidden = true;
  </script>
  <slot />
</PageLayout>

<script>
  const banner = document.getElementById("wip-banner");
  banner?.querySelector(".wip-close")?.addEventListener("click", () => {
    banner.hidden = true;
    localStorage.setItem("standards-wip-dismissed", "1");
  });
</script>

<style>
  .wip {
    background: var(--brand-grey);
    border-bottom: 1px solid var(--brand-grey--border);
    color: var(--cd-grey--800);
  }
  .wip[hidden] {
    display: none;
  }
  .wip-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }
  .wip-badge {
    flex: none;
    padding: 0 0.45rem;
    border: 1px solid var(--brand-warning);
    border-radius: var(--brand-radius--pill);
    color: var(--brand-warning);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .wip p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.4;
  }
  .wip-close {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--brand-grey--text);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .wip-close:hover,
  .wip-close:focus-visible {
    background: var(--brand-grey--border);
    color: var(--cd-grey--900);
  }
  @media (max-width: 600px) {
    .wip-inner {
      justify-content: flex-start;
      padding-left: 1rem;
      padding-right: 0.5rem;
    }
    .wip p {
      font-size: 0.78rem;
    }
  }
</style>
