---
import "$lib/status/status.css";
import Masthead from "$lib/components/Masthead.astro";
import Term from "$lib/components/Term.astro";
import { statusBase } from "$lib/utils/paths";
import type { loadData } from "$lib/status/loadData";
import Layout from "./Layout.astro";

interface Props {
  data: ReturnType<typeof loadData>;
}

const { data } = Astro.props;
const { openTotal, overdueTotal, psTotal, infoRows } = data;
const lastUpdatedFormatted = data.lastUpdatedAt
  ? new Date(data.lastUpdatedAt).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : null;

const dataBase = `${statusBase}data/`;
const page = Astro.url.pathname.replace(/\/$/, "").split("/").at(-1);
---

<Layout
  title="COD Status Dashboard"
  description="COD-AB and COD-PS availability, COD-AB work orders, COD-AB review schedule, and COD-PS age."
>
  <Masthead title="COD Status Dashboard" width="1200px">
    <p class="tagline">
      Data updated daily at 06:00 UTC
      {lastUpdatedFormatted && `. Last updated ${lastUpdatedFormatted}.`}
    </p>
  </Masthead>

  <main class="status-page">
    <nav class="tab-bar">
      <a href={statusBase} class:list={["tab-btn", { active: page === "status" }]}>
        <span class="tab-left">
          <span class="tab-title">Info</span>
          <span class="tab-desc">COD-AB &amp; COD-PS by location</span>
        </span>
        <span class="tab-count">
          {infoRows.length}
          <span class="tab-denom"> locations</span>
        </span>
      </a>
      <a href={`${statusBase}work`} class:list={["tab-btn", { active: page === "work" }]}>
        <span class="tab-left">
          <span class="tab-title">
            <Term term="work-order">Work</Term>
          </span>
          <span class="tab-desc">
            <Term term="pipeline">Pipeline</Term> &amp; status tracking
          </span>
        </span>
        <span class="tab-count">
          {openTotal}
          <span class="tab-denom"> open</span>
        </span>
      </a>
      <a href={`${statusBase}ab`} class:list={["tab-btn", { active: page === "ab" }]}>
        <span class="tab-left">
          <span class="tab-title">AB Reviews</span>
          <span class="tab-desc">COD-AB review schedule</span>
        </span>
        <span class="tab-count">
          {overdueTotal}
          <span class="tab-denom"> overdue</span>
        </span>
      </a>
      <a href={`${statusBase}ps`} class:list={["tab-btn", { active: page === "ps" }]}>
        <span class="tab-left">
          <span class="tab-title">PS Reviews</span>
          <span class="tab-desc">COD-PS age by plan priority</span>
        </span>
        <span class="tab-count">
          {psTotal}
          <span class="tab-denom"> locations</span>
        </span>
      </a>
    </nav>

    <slot />

    <footer>
      <span>Download:</span>
      <span class="footer-group">
        <span class="group-label">JIRA</span>
        <a href={`${dataBase}work.csv`}>Work orders</a>
      </span>
      <span class="footer-group">
        <span class="group-label">ArcGIS</span>
        <a href={`${dataBase}gis.csv`}>Locations</a>
        <a href={`${dataBase}cod_metadata.csv`}>Metadata</a>
      </span>
      <span class="footer-group">
        <span class="group-label">External</span>
        <a href={`${dataBase}hdx.csv`}>HDX</a>
        <a href={`${dataBase}cod_ps.csv`}>COD-PS</a>
        <a href={`${dataBase}levels.csv`}>Levels</a>
        <a href={`${dataBase}m49.csv`}>M49</a>
        <a href={`${dataBase}plans.csv`}>Plans</a>
        <a href={`${dataBase}offices.csv`}>Offices</a>
        <a href={`${dataBase}regions.csv`}>Regions</a>
      </span>
    </footer>
  </main>
</Layout>

<style>
  .status-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
    font-family: var(--brand-font);
    font-size: 14px;
    line-height: 1.5;
  }

  .tab-bar {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .tab-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    flex: 1;
    background: var(--cd-white);
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius);
    text-align: left;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .tab-btn:not(.active):hover {
    border-color: var(--brand-primary);
    box-shadow: inset 4px 0 0 var(--brand-primary);
  }

  .tab-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tab-count {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--brand-primary--text);
    line-height: 1;
    white-space: nowrap;
  }

  .tab-btn:not(.active) .tab-count {
    color: var(--cd-grey--700);
  }

  .tab-denom {
    font-size: 0.75em;
    font-weight: 500;
    opacity: 0.6;
  }

  .tab-btn.active {
    padding: calc(0.75rem - 1px) calc(1.25rem - 1px);
    border: 2px solid var(--brand-primary--text);
    box-shadow: inset 6px 0 0 var(--brand-primary--text);
  }

  .tab-btn.active .tab-title {
    color: var(--brand-primary--text);
  }

  .tab-title {
    font-family: var(--brand-font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--cd-grey--900);
  }

  .tab-desc {
    font-size: 12px;
    color: var(--cd-grey--700);
  }

  footer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--brand-primary--lightest);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--cd-grey--700);
  }

  footer a {
    color: var(--brand-primary--text);
    text-decoration: none;
  }

  footer a:hover {
    text-decoration: underline;
  }

  .footer-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-group + .footer-group {
    border-left: 1px solid var(--cd-grey--400);
    padding-left: 0.5rem;
  }

  .group-label {
    font-weight: 600;
    color: var(--cd-grey--900);
  }
</style>
