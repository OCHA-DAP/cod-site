---
interface Props {
  caption: string;
  source: { href: string; label: string };
  class?: string;
}

const { caption, source, class: className } = Astro.props;
---

<figure class:list={["un80-figure", className]}>
  <slot />
  <figcaption>
    {caption} Source: <a href={source.href}>{source.label}</a>.
  </figcaption>
</figure>

<style>
  .un80-figure {
    margin: 1.5rem 0 2.5rem;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--brand-grey--text);
  }
</style>
