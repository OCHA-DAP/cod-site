---
interface Props {
  nested?: boolean;
}

const { nested = false } = Astro.props;
---

<div class={`group ${nested ? "nested" : ""}`}>
  <slot />
</div>

<style>
  .group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .group.nested {
    padding: 0.875rem;
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius);
    background: var(--cd-white);
  }
</style>
