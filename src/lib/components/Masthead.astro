---
import SiteHeader from "$lib/components/SiteHeader.astro";

interface Props {
  title: string;
  width?: string;
}

const { title, width = "720px" } = Astro.props;
---

<header class="masthead">
  <SiteHeader />
  <div class="masthead-inner" style={`max-width: ${width}`}>
    <h1>{title}</h1>
    <slot />
  </div>
</header>

<style>
  .masthead-inner {
    margin: 0 auto;
    padding: 2rem 1.5rem 0.5rem;
  }
  .masthead h1 {
    color: var(--brand-primary--text);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .masthead :global(.tagline) {
    font-size: 1rem;
    color: var(--cd-grey--800);
    margin: 0;
    line-height: 1.55;
    max-width: 56ch;
  }
</style>
