---
import { base, standardsBase, toolsBase } from "$lib/utils/paths";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const slash = (p: string) => p.replace(/\/?$/, "/");
const path = slash(Astro.url.pathname);
const current = (href: string, prefix = false) =>
  (prefix ? path.startsWith(href) : path === slash(href)) ? "page" : undefined;
// An exact match wins over a prefix match, so only one link in a menu is marked current.
const currentIn = (links: { href: string; prefix?: boolean }[]) =>
  links.find((l) => current(l.href)) ?? links.find((l) => current(l.href, l.prefix));
const menus = [
  {
    label: "Standards",
    base: standardsBase,
    links: [
      { href: standardsBase, label: "Overview" },
      { href: `${standardsBase}specification/`, label: "Specification", prefix: true },
      { href: `${standardsBase}process/`, label: "Process", prefix: true },
      { href: `${standardsBase}process/request/`, label: "Request an update" },
    ],
  },
  {
    label: "Tools",
    base: toolsBase,
    links: [
      { href: toolsBase, label: "Overview" },
      { href: `${toolsBase}intro`, label: "Intro" },
      { href: `${toolsBase}docs/`, label: "CLI Docs", prefix: true },
    ],
  },
];
const statusHref = `${base}status/`;
const explorerHref = `${base}explorer/`;
---

<div class:list={["bar", className]}>
  <a class="home" href={base}>
    <span class="wordmark">
      <img src={`${base}logos/cod-logo.svg`} alt="Common Operational Datasets" />
    </span>
  </a>
  <slot />
  <nav class="topnav" aria-label="Site">
    {menus.map((m) => (
      <details class="menu">
        <summary class:list={{ active: path.startsWith(m.base) }}>
          {m.label}<span class="caret" aria-hidden="true"></span>
        </summary>
        <div class="menu-panel">
          {m.links.map((l) => (
            <a href={l.href} aria-current={l === currentIn(m.links) ? "page" : undefined}>
              {l.label}
            </a>
          ))}
        </div>
      </details>
    ))}
    <a href={statusHref} aria-current={current(statusHref, true)}>Status</a>
    <a href={explorerHref} aria-current={current(explorerHref)}>Explorer</a>
  </nav>
</div>

<script>
  const close = (except?: Element) =>
    document.querySelectorAll<HTMLDetailsElement>(".bar details.menu[open]").forEach((d) => {
      if (d !== except) d.open = false;
    });
  document.addEventListener("click", (e) => close((e.target as Element).closest(".bar details.menu") ?? undefined));
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const open = document.querySelector<HTMLDetailsElement>(".bar details.menu[open]");
    if (!open) return;
    open.open = false;
    open.querySelector("summary")?.focus();
  });
</script>

<style>
  .bar {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
    padding: 0 1.5rem;
    background: var(--cd-white);
    border-bottom: 1px solid var(--brand-grey--border);
    color: var(--cd-grey--800);
  }
  .home {
    display: inline-flex;
    text-decoration: none;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
  }
  .wordmark img {
    height: 40px;
    width: auto;
  }
  .topnav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.95rem;
    font-family: var(--brand-font);
  }
  .topnav {
    align-items: center;
  }
  .topnav > a,
  .menu summary {
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .topnav > a:hover,
  .menu summary:hover {
    color: var(--brand-primary--dark);
  }
  .topnav > a[aria-current="page"],
  .menu summary.active {
    color: var(--brand-primary--text);
    font-weight: 600;
  }
  .menu {
    position: relative;
  }
  .menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .caret {
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15rem) rotate(45deg);
  }
  .menu[open] .caret {
    transform: translateY(0.1rem) rotate(-135deg);
  }
  .menu-panel {
    position: absolute;
    top: calc(100% + 0.9rem);
    right: -1rem;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    min-width: 11rem;
    padding: 0.4rem 0;
    background: var(--cd-white);
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius--sm);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  }
  .menu-panel a {
    padding: 0.5rem 1rem;
    color: var(--cd-grey--800);
    text-decoration: none;
  }
  .menu-panel a:hover,
  .menu-panel a:focus-visible {
    background: var(--brand-primary--lightest);
    color: var(--brand-primary--dark);
  }
  @media (max-width: 30rem) {
    .bar {
      gap: 0.5rem;
      padding: 0 0.75rem;
    }
    .wordmark img {
      height: 30px;
    }
    .topnav {
      gap: 0.7rem;
      font-size: 0.85rem;
    }
    .menu summary {
      gap: 0.25rem;
    }
  }
  .menu-panel a[aria-current="page"] {
    background: var(--brand-primary--lightest);
    color: var(--brand-primary--text);
    font-weight: 600;
  }
</style>
