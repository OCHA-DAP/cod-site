---
import { GLOSSARY, type TermSlug } from "$lib/glossary";
import Tooltip from "./Tooltip.astro";

interface Props {
  term: TermSlug;
  align?: "left" | "right";
}

const { term, align = "left" } = Astro.props;
const entry = GLOSSARY[term];
---

{entry ? (
  <Tooltip class="term" align={align}>
    <slot />
    <Fragment slot="tip">{entry.definition}</Fragment>
  </Tooltip>
) : (
  <slot />
)}

<style>
  :global(.term) {
    cursor: help;
    border-bottom: 1px dotted transparent;
  }

  :global(.term:hover),
  :global(.term:focus-visible) {
    border-bottom-color: currentColor;
  }
</style>
