---
interface Props {
  headings: { slug: string; text: string }[];
}

const { headings } = Astro.props;
---

{headings.length > 1 && (
  <aside class="toc" aria-label="On this page">
    <p>On this page</p>
    <ul>
      {headings.map((h) => (
        <li>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .toc {
    position: sticky;
    top: 5rem;
    align-self: start;
    font-size: 0.9rem;
  }
  .toc p {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-grey--text);
  }
  .toc ul {
    margin: 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--cd-blue--lightest);
    list-style: none;
  }
  .toc li {
    margin: 0.5rem 0;
    line-height: 1.4;
  }
  .toc a {
    color: var(--cd-grey--800);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--brand-primary--dark);
  }
  @media (max-width: 960px) {
    .toc {
      display: none;
    }
  }
</style>
