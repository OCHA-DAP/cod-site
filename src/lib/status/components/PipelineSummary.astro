---
import type { PipelineCount } from "$lib/status/loadData";
import { statusClass, STATUS_TERMS } from "$lib/status/status";
import Term from "$lib/components/Term.astro";
import type { TermSlug } from "$lib/glossary";

interface Props {
  pipeline: PipelineCount[];
}

const { pipeline } = Astro.props;
const total = pipeline.reduce((sum, item) => sum + item.count, 0);
---

<style>
  .pipeline-card {
    border-top: 1px solid var(--brand-primary--lightest);
    padding: 2rem 0 0.5rem;
    margin-bottom: 1rem;
  }

  .pipeline-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .pipeline-title {
    font-family: var(--brand-font-heading);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .pipeline-total {
    font-size: 12px;
    color: var(--cd-grey--700);
    background: var(--cd-grey--300);
    border: 1px solid var(--cd-grey--400);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
</style>

<div class="pipeline-card">
  <div class="pipeline-header">
    <span class="pipeline-title">
      <Term term="pipeline">Pipeline</Term>
    </span>
    <span class="pipeline-total">{total} total</span>
  </div>
  <div class="figure-row">
    {pipeline.map((item) => (
      <div class={`figure ${statusClass(item.status)}`}>
        <span class="figure-num">{item.count}</span>
        <span class="figure-lbl">
          <Term term={STATUS_TERMS[item.status] as TermSlug}>{item.label}</Term>
        </span>
      </div>
    ))}
  </div>
</div>
