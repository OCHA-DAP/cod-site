---
import type { PlanGroup } from "$lib/status/loadData";
import Term from "$lib/components/Term.astro";
import type { TermSlug } from "$lib/glossary";

interface Props {
  planGroups: PlanGroup[];
}

const { planGroups } = Astro.props;

function overdueClass(overdue: number, total: number): string {
  if (total === 0 || overdue === 0) return "s-ok";
  const pct = overdue / total;
  if (pct <= 0.25) return "s-warn-low";
  if (pct <= 0.5) return "s-warn-mid";
  return "s-critical";
}
---

<div class="figure-row cycle-row">
  {planGroups.map((group) => {
    const total = group.countries.length;
    const overdue = group.countries.filter((c) => c.review_overdue).length;
    return (
      <a class={`figure ${overdueClass(overdue, total)}`} href={`#${group.key}`}>
        <span class="figure-title">
          <Term term={group.key as TermSlug}>{group.label}</Term>
        </span>
        <span class="figure-num">
          {overdue}
          <span class="figure-denom">/{total}</span>
        </span>
        <span class="figure-lbl">
          <Term term="review-overdue">Overdue</Term>
        </span>
      </a>
    );
  })}
</div>

<style>
  .cycle-row {
    margin-bottom: 1.25rem;
  }
</style>
