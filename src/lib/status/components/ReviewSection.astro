---
import BoolDot from "$lib/status/components/BoolDot.astro";
import type { PlanCountry, PlanGroup } from "$lib/status/loadData";
import Term from "$lib/components/Term.astro";
import type { TermSlug } from "$lib/glossary";
import { statusClass, statusLabel } from "$lib/status/status";

interface Props {
  planGroups: PlanGroup[];
  dataset: "ab" | "ps";
}

const { planGroups, dataset } = Astro.props;
const ps = dataset === "ps";
const available = (row: PlanCountry) => (ps ? row.ps_reference_year !== undefined : row.inGis);
---

{planGroups.map((group) => (
  <section id={group.key}>
    <h2>
      <Term term={group.key as TermSlug}>{group.label}</Term>
      {!ps &&
        (() => {
          const overdue = group.countries.filter((c) => c.review_overdue).length;
          return overdue > 0 ? (
            <span class="count-chip warn">{overdue} overdue</span>
          ) : (
            <span class="count-chip done">All on schedule</span>
          );
        })()}
    </h2>

    {group.countries.length > 0 ? (
      <table>
        <colgroup>
          <col style="width: 23%" />
          <col style="width: 7%" />
          <col style="width: 12%" />
          <col style="width: 10%" />
          <col style="width: 11%" />
          <col style="width: 12%" />
          <col style="width: 13%" />
          <col style="width: 12%" />
        </colgroup>
        <thead>
          <tr>
            <th>Location</th>
            <th>
              <Term term={ps ? "ps-available" : "ab-available"}>Available</Term>
            </th>
            <th>
              <Term term="plan-type">Plan Types</Term>
            </th>
            <th>Plan Year</th>
            <th>
              <Term term="office-type">Office Type</Term>
            </th>
            <th>
              <Term term="regional-office">Regional Office</Term>
            </th>
            <th>
              {ps ? <Term term="ps-age">Age</Term> : <Term term="next-review">Next Review</Term>}
            </th>
            <th>
              {ps ? (
                <Term term="ps-reference-year" align="right">
                  Reference Year
                </Term>
              ) : (
                <Term term="work-order" align="right">
                  Work Order
                </Term>
              )}
            </th>
          </tr>
        </thead>
        <tbody>
          {group.countries.map((row) => (
            <tr>
              <td>
                {(ps ? row.psUrl : row.hdxUrl) ? (
                  <a href={ps ? row.psUrl : row.hdxUrl} target="_blank" rel="noopener">
                    {row.name_en}
                  </a>
                ) : (
                  row.name_en
                )}{" "}
                <span class="iso3">{row.iso3}</span>
              </td>
              <td style="text-align: center">
                <BoolDot on={available(row)} label={available(row) ? "Yes" : "No"} />
              </td>
              <td>{row.plan_types.join(" / ") || "—"}</td>
              <td>{row.plan_years?.join(" / ") || "—"}</td>
              <td>{row.office_type || "—"}</td>
              <td>{row.regional || "—"}</td>
              {ps ? (
                <td>{row.ps_age ?? "—"}</td>
              ) : (
                <td class={row.review_overdue ? "flag-no" : ""}>
                  <span title={row.next_review_date}>{row.next_review_relative ?? "—"}</span>
                </td>
              )}
              <td>
                {ps ? (
                  (row.ps_reference_year ?? "—")
                ) : row.open_work_order_status ? (
                  <Term term={`status-${row.open_work_order_status}` as TermSlug} align="right">
                    <span class={`badge ${statusClass(row.open_work_order_status)}`}>
                      {statusLabel(row.open_work_order_status)}
                    </span>
                  </Term>
                ) : (
                  "—"
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="empty">No locations found.</p>
    )}
  </section>
))}

<style>
  section {
    scroll-margin-top: 0.75rem;
  }

  .flag-no {
    color: var(--brand-warning);
    font-weight: 600;
  }
</style>
