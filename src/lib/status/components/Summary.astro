---
import type { PlanGroup } from "$lib/status/loadData";
import Tooltip from "$lib/components/Tooltip.astro";

interface Props {
  planGroups: PlanGroup[];
  page: "info" | "review";
}

const { planGroups, page } = Astro.props;

const short = (g: PlanGroup) => {
  const year = g.label.match(/\((\d{4})\)/)?.[1];
  if (g.key === "no-plans") return "No plans";
  const kind = g.key.endsWith("priority") ? "HNRP/HRP/FA" : "Other";
  return `${kind} ${year ?? "prior"}`;
};

const ramp = ["var(--brand-primary--text)", "var(--brand-primary--light)", "var(--cd-grey--500)"];
const legend = (
  page === "review"
    ? [
        { key: "ok", label: "Current" },
        { key: "overdue", label: "Overdue" },
        { key: "none", label: "Not available" },
      ]
    : [
        { key: "joined", label: "Full" },
        { key: "mismatched", label: "Partial" },
        { key: "none", label: "Not available" },
      ]
).map((l, i) => ({ ...l, color: ramp[i] }));
const subject = page === "review" ? "COD-AB review" : "COD-PS join to COD-AB";

const groups = planGroups.map((g) => {
  const rows = page === "review" ? g.countries : g.countries.filter((c) => c.inGis);
  const counts: Record<string, number> =
    page === "review"
      ? (() => {
          const ab = rows.filter((c) => c.inGis);
          const overdue = ab.filter((c) => c.review_overdue).length;
          return { overdue, ok: ab.length - overdue, none: rows.length - ab.length };
        })()
      : {
          joined: rows.filter((c) => c.ps_match === "joined").length,
          mismatched: rows.filter((c) => c.ps_match === "mismatched").length,
          none: rows.filter((c) => c.ps_match === undefined).length,
        };
  const total = rows.length;
  const head = counts[legend[0].key];
  // Review headlines count out of locations with a COD-AB.
  const base = page === "review" ? total - counts.none : total;
  return { key: g.key, short: short(g), counts, total, base, head };
});

const pct = (g: (typeof groups)[number]) => (g.base ? Math.round((g.head / g.base) * 100) : 0);
const denom = page === "review" ? "locations with a COD-AB" : "locations";

// Circumference 100 so dash lengths are percentages.
const R = 15.9155;
const segments = (g: (typeof groups)[number]) => {
  let offset = 25;
  return legend.map((l) => {
    const pct = g.total ? (g.counts[l.key] / g.total) * 100 : 0;
    const seg = { color: l.color, dash: `${pct} ${100 - pct}`, offset };
    offset -= pct;
    return seg;
  });
};
---

<div class="summary">
  <p class="caption">
    <strong>{subject}</strong>
    {legend.map((l) => (
      <span class="key">
        <span class="swatch" style={`background: ${l.color}`} />
        {l.label}
      </span>
    ))}
  </p>
  <div class="donuts">
    {groups.map((g, i) => (
      <a class="donut" href={`#${g.key}`}>
        <Tooltip block align={i === groups.length - 1 ? "right" : "left"}>
          <svg viewBox="0 0 42 42" aria-hidden="true">
            <circle
              cx="21"
              cy="21"
              r={R}
              fill="none"
              stroke="var(--cd-grey--300)"
              stroke-width="5"
            />
            {segments(g).map((s) => (
              <circle
                cx="21"
                cy="21"
                r={R}
                fill="none"
                stroke={s.color}
                stroke-width="5"
                stroke-dasharray={s.dash}
                stroke-dashoffset={s.offset}
              />
            ))}
            <text
              x="21"
              y="21"
              text-anchor="middle"
              dominant-baseline="central"
              class="donut-num"
            >{`${pct(g)}%`}</text>
          </svg>
          <span class="name">{g.short}</span>
          <span slot="tip" class="tip">
            <span class="tip-head">
              {pct(g)}% {legend[0].label.toLowerCase()}: {g.head} of {g.base} {denom}
            </span>
            {legend.map((l, j) => (
              <span class:list={["tip-row", { lead: j === 0 }]}>
                <span class="swatch" style={`background: ${l.color}`} />
                <span>{l.label}</span>
                <span class="tip-num">{g.counts[l.key]}</span>
              </span>
            ))}
          </span>
        </Tooltip>
      </a>
    ))}
  </div>
</div>

<style>
  .summary {
    margin-bottom: 1.5rem;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin: 0 0 0.75rem;
    font-size: 12px;
    color: var(--cd-grey--700);
  }

  .caption strong {
    color: var(--cd-grey--900);
    font-weight: 600;
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .swatch {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .donuts {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    text-align: center;
  }

  .donut {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    font-size: 12px;
    color: inherit;
    text-decoration: none;
  }

  .donut :global(.tooltip) {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
  }

  .tip {
    display: grid;
    grid-template-columns: auto auto auto;
    column-gap: 0.4rem;
    row-gap: 0.1rem;
    align-items: center;
    white-space: nowrap;
  }

  .tip-head {
    grid-column: 1 / -1;
    margin-bottom: 0.25rem;
    font-weight: 600;
  }

  .tip-row {
    display: contents;
    color: var(--cd-grey--400);
  }

  .tip-row.lead {
    color: var(--cd-white);
    font-weight: 600;
  }

  .tip-num {
    text-align: right;
  }

  .donut svg {
    width: 84px;
    height: 84px;
  }

  .donut-num {
    font-size: 10px;
    font-weight: 700;
    fill: var(--cd-grey--900);
  }

  .donut .name {
    color: var(--cd-grey--900);
    font-weight: 600;
  }
</style>
