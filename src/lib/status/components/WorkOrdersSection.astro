---
import type { ScheduleGroup } from "$lib/status/loadData";
import Term from "$lib/components/Term.astro";
import WorkOrderTable from "./WorkOrderTable.astro";

interface Props {
  workByQuarter: ScheduleGroup[];
  open: number;
}

const { workByQuarter, open } = Astro.props;
---

<section>
  <h2>
    <Term term="work-order">Work Orders</Term>
    <span class={`count-chip ${open === 0 ? "done" : ""}`}>
      {open === 0 ? "None open" : `${open} open`}
    </span>
  </h2>
  <p class="section-desc">
    All tracked work orders, grouped by <Term term="planned-quarter">planned delivery quarter</Term>
    .
  </p>

  {workByQuarter.length === 0 ? (
    <p class="empty">No work orders yet.</p>
  ) : (
    <WorkOrderTable groups={workByQuarter} />
  )}
</section>
