---
import Arrow from "$lib/components/Arrow.svelte";
import HomeGlobe from "$lib/components/home/HomeGlobe.svelte";
import SiteHeader from "$lib/components/SiteHeader.astro";
import { loadData } from "$lib/status/loadData";
import { base, standardsBase, toolsBase } from "$lib/utils/paths";
import Layout from "../layouts/Layout.astro";

const lede =
  "Administrative boundaries and population statistics to support coordinated humanitarian preparedness and response.";

const { totalInGis, adminUnits, openTotal } = loadData();
const stats = [
  { value: totalInGis, label: "countries and territories", href: `${base}status/` },
  { value: adminUnits, label: "administrative units", href: `${base}status/` },
  { value: openTotal, label: "updates in progress", href: `${base}status/work` },
].sort((a, b) => a.value - b.value);

const products = [
  {
    href: `${base}about/`,
    title: "About",
    text: "Why CODs exist, how P-codes let organizations link their data, and how CODs are used throughout a humanitarian response.",
    image: `${base}home/about.webp`,
  },
  {
    href: standardsBase,
    title: "Standards",
    text: "The shared rules behind COD-AB: how P-codes and fields are structured, and how each dataset is produced, reviewed and published.",
    image: `${base}home/standards.webp`,
    extra: { href: `${standardsBase}process/request/`, label: "Request an update" },
  },
  {
    href: toolsBase,
    title: "Tools",
    text: "Take a raw administrative boundary delivery through to a clean, coded, packaged release, one step at a time. All processing runs in your browser via WebAssembly, so your files never leave your device.",
    image: `${base}home/tools.webp`,
  },
  {
    href: `${base}status/`,
    title: "Status",
    text: "COD-AB and COD-PS levels and reference years by location, work orders, and review schedules.",
    image: `${base}home/status.webp`,
  },
  {
    href: `${base}explorer/`,
    title: "Explorer",
    text: "Compare administrative boundaries from OCHA and partner agencies, country by country, and see which source each country uses.",
    image: `${base}home/explorer.webp`,
  },
];

// Heights match the emblems, not the files: WFP and IOM set their names above or below theirs.
const logos = [
  { file: "ocha-blue.svg", alt: "OCHA", height: 36, href: "https://www.unocha.org/" },
  { file: "wfp-blue.svg", alt: "WFP", height: 45, href: "https://www.wfp.org/" },
  { file: "unicef-blue.svg", alt: "UNICEF", height: 36, href: "https://www.unicef.org/" },
  { file: "unhcr-blue.svg", alt: "UNHCR", height: 40, href: "https://www.unhcr.org/" },
  { file: "iom-blue.svg", alt: "IOM", height: 34, href: "https://www.iom.int/" },
];
---

<Layout title="CODs: Common Operational Datasets" description={lede}>
  <link slot="head" rel="preconnect" href="https://data.source.coop" crossorigin />
  <div class="home">
    <SiteHeader />

    <main>
      <div class="grid-bg">
        <section class="wrap hero">
          <div class="hero-text">
            <h1><span class="name">Common<br />Operational<br />Datasets</span> <span class="tagline">for humanitarian response</span></h1>
            <p class="lede">{lede}</p>
          </div>
          <div class="hero-globe">
            <HomeGlobe client:load />
          </div>
        </section>
      </div>

      <section class="band stats" aria-label="Key figures">
        <div class="wrap stats-row">
          {stats.map((s, i) => (
            <a class="stat" href={s.href} data-reveal style={`--delay: ${i * 100}ms`}>
              <b class="figure-num" data-count={s.value}>{s.value.toLocaleString("en-US")}</b>
              <span>{s.label}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="band">
        <div class="intro" data-reveal>
          <h2>What are CODs?</h2>
          <p>
            Common Operational Datasets (CODs) are administrative boundaries (COD-AB) and population
            statistics (COD-PS). They are ‘best available’ datasets that ensure consistency and
            simplify the management of key data.
          </p>
          <p>
            National authorities are the primary source of most CODs, and the relevant Information
            Management Working Group accepts them in country or in their region. CODs reflect the
            local administrative hierarchy and are annotated with place names and P-codes. They
            provide a common operational picture of a crisis and a geographic framework for data
            collection, analysis and visualization, and are disseminated on the <a
              href="https://data.humdata.org/">Humanitarian Data Exchange (HDX)</a>.
          </p>
          <dl class="types">
            <div>
              <dt><a href="https://data.humdata.org/dataset/cod-ab-global">Administrative boundaries (COD&#8209;AB)</a></dt>
              <dd>
                Geographic boundaries and gazetteers of feature names and P-codes, reflecting each
                country’s administrative hierarchy.
              </dd>
            </div>
            <div>
              <dt><a href="https://data.humdata.org/dataset/cod-ps-global">Population statistics (COD&#8209;PS)</a></dt>
              <dd>
                Baseline, age- and sex-disaggregated population figures of a country’s pre-crisis
                situation, linkable to COD-AB using P-codes.
              </dd>
            </div>
          </dl>
        </div>
      </section>

      {products.map((p, i) => (
        <section class="band grid-bg">
          <div class:list={["wrap", "product", { reverse: i % 2 === 1 }]}>
            <div data-reveal>
              <h2>{p.title}</h2>
              <p class="product-text">{p.text}</p>
              <div class="links">
                <a class="more" href={p.href}>
                  Open {p.title} <Arrow />
                </a>
                {p.extra && (
                  <a class="more secondary" href={p.extra.href}>
                    {p.extra.label} <Arrow />
                  </a>
                )}
              </div>
            </div>
            <a
              class="shot"
              href={p.href}
              tabindex="-1"
              aria-hidden="true"
              data-reveal
              style="--delay: 100ms"
            >
              <img src={p.image} alt="" loading="lazy" width="1200" height="750" />
            </a>
          </div>
        </section>
      ))}
    </main>

    <footer>
      <p>Managed by</p>
      <div class="logos">
        {logos.map((l) => (
          <a href={l.href}>
            <img src={`${base}logos/${l.file}`} alt={l.alt} style={`height: ${l.height}px`} />
          </a>
        ))}
      </div>
    </footer>
  </div>
</Layout>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.count);
    const steps = 18;
    let step = 0;
    const timer = setInterval(() => {
      step++;
      el.textContent = Math.round((target * step) / steps).toLocaleString("en-US");
      if (step === steps) {
        clearInterval(timer);
        el.classList.add("settle");
        el.addEventListener("animationend", () => el.classList.remove("settle"), { once: true });
      }
    }, 40);
  }

  if (!reduceMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          observer.unobserve(el);
          el.classList.remove("pending");
          el.querySelectorAll<HTMLElement>("[data-count]").forEach((n) => {
            setTimeout(() => countUp(n), parseInt(getComputedStyle(el).transitionDelay) || 0);
          });
        }
      },
      { rootMargin: "0px 0px -10% 0px" },
    );
    for (const el of document.querySelectorAll<HTMLElement>("[data-reveal]")) {
      // Content already on screen at load stays put; only counters start from zero.
      if (el.getBoundingClientRect().top < innerHeight) {
        if (!el.querySelector("[data-count]")) continue;
      } else {
        el.classList.add("pending");
      }
      el.querySelectorAll<HTMLElement>("[data-count]").forEach((n) => (n.textContent = "0"));
      observer.observe(el);
    }
  }
</script>

<style>
  .home {
    overflow-x: clip;
    font-family: var(--brand-font);
    background: var(--cd-white);
  }
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  h1,
  h2 {
    color: var(--brand-primary--text);
    letter-spacing: -0.02em;
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    min-height: 620px;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
  h1 {
    font-weight: 700;
    margin: 0.75rem 0 1.25rem;
  }
  h1 .name {
    display: block;
    font-size: 3.4rem;
    line-height: 1.02;
  }
  h1 .tagline {
    display: block;
    margin-top: 0.6rem;
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.25;
  }
  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--cd-grey--800);
    max-width: 44ch;
    margin: 0;
  }
  .hero-globe {
    width: 760px;
    margin-right: -260px;
    justify-self: end;
  }
  .band {
    border-top: 1px solid var(--cd-blue--lightest);
  }
  .intro {
    max-width: 760px;
    margin: 0 auto;
    padding: 5rem 2rem;
  }
  .intro h2,
  .product h2 {
    font-size: 2rem;
    margin: 0 0 1rem;
  }
  .intro p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--cd-grey--800);
  }
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--cd-grey--800);
  }
  .stat b {
    align-self: flex-start;
    font-size: 3rem;
  }
  .stat:hover span {
    text-decoration: underline;
  }
  :global(.settle) {
    animation: settle var(--dur-enter) var(--ease-enter);
  }
  @keyframes settle {
    40% {
      transform: scale(1.12);
    }
  }
  [data-reveal] {
    transition:
      opacity var(--dur-enter) var(--ease-enter) var(--delay, 0ms),
      transform var(--dur-enter) var(--ease-enter) var(--delay, 0ms);
  }
  :global([data-reveal].pending) {
    opacity: 0;
    transform: translateY(var(--move-layer));
  }
  .types {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 2rem 0 0;
  }
  .types div {
    padding: 1.25rem 1.5rem 1.25rem 1.875rem;
    border: 1px solid var(--cd-grey--500);
    border-radius: var(--brand-radius);
    background: var(--cd-white);
    box-shadow: inset 6px 0 0 var(--brand-primary--text);
    position: relative;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .types div:hover {
    border-color: var(--brand-primary--text);
    box-shadow: inset 10px 0 0 var(--brand-primary--text);
  }
  .types dt {
    font-family: var(--brand-font-heading);
    font-weight: 700;
    color: var(--brand-primary--text);
    margin-bottom: 0.4rem;
  }
  .types dt a {
    color: inherit;
    text-decoration: none;
  }
  /* Stretches the title link over the whole box. */
  .types dt a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .types dd {
    margin: 0;
    line-height: 1.6;
    color: var(--cd-grey--800);
  }
  .product {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 4rem;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
  .product.reverse {
    grid-template-columns: 1.3fr 1fr;
  }
  .product.reverse .shot {
    order: -1;
  }
  .product-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--cd-grey--800);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--brand-primary--text);
    font-weight: 700;
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .more.secondary {
    font-weight: 500;
  }
  .shot {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--cd-blue--lightest);
    box-shadow: 0 20px 50px -20px rgba(0, 46, 110, 0.35);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  footer {
    padding: 2.5rem 2rem;
    border-top: 1px solid var(--cd-blue--lightest);
    text-align: center;
  }
  footer p {
    margin: 0 0 16px;
    font-size: var(--cd-font-size--small);
    color: var(--brand-grey--text);
  }
  .logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 32px 48px;
  }
  .logos a {
    display: flex;
  }
  footer img {
    width: auto;
  }
  @media (max-width: 900px) {
    .hero,
    .product,
    .product.reverse,
    .stats-row,
    .types {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: 0;
    }
    .hero-globe {
      width: 100%;
      margin-right: 0;
      justify-self: stretch;
    }
    .product.reverse .shot {
      order: 0;
    }
  }
</style>
