---
import Masthead from "$lib/components/Masthead.astro";
import { base, toolsBase } from "$lib/utils/paths";
import Layout from "../layouts/Layout.astro";

const links = [
  {
    href: toolsBase,
    title: "Tools",
    text: "Clean, code and package administrative boundaries in your browser.",
  },
  {
    href: `${base}status/`,
    title: "Status",
    text: "Track COD-AB work orders and coverage across humanitarian response plans.",
  },
];
---

<Layout
  title="COD-AB: Common Operational Datasets for administrative boundaries"
  description="Tools and status tracking for Common Operational Datasets on administrative boundaries (COD-AB)."
>
  <Masthead title="COD-AB" toolsNav={false}>
    <p class="tagline">Common Operational Datasets for administrative boundaries.</p>
  </Masthead>

  <main class="page">
    {links.map((l) => (
      <a class="card" href={l.href}>
        <h2>{l.title}</h2>
        <p>{l.text}</p>
      </a>
    ))}
  </main>
</Layout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    display: grid;
    gap: 1rem;
    font-family: var(--brand-font);
  }
  .card {
    display: block;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--cd-grey--400);
    border-radius: var(--brand-radius--sm);
    background: var(--cd-white);
    color: var(--cd-grey--900);
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--brand-primary);
  }
  .card h2 {
    margin: 0 0 0.35rem;
    font-size: 1.125rem;
    color: var(--brand-primary--text);
  }
  .card p {
    margin: 0;
    color: var(--cd-grey--800);
  }
</style>
