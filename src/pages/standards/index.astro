---
import Arrow from "$lib/components/Arrow.svelte";
import DocCards from "$lib/components/DocCards.astro";
import { loadStandards } from "$lib/standards/docs";
import { standardsBase } from "$lib/utils/paths";
import StandardsLayout from "../../layouts/StandardsLayout.astro";

const docs = await loadStandards();
const summary =
  "The shared rules behind COD-AB: what the data looks like, and how it is produced, reviewed and published.";
---

<StandardsLayout title="COD-AB Standards" summary={summary}>
  <section class="wrap" aria-label="Request an update">
    <div class="request">
      <p>
        <b>Has a country's boundary data changed?</b> Tell us through the COD-AB Request Form.
      </p>
      <a href={`${standardsBase}process/request/`}>Request an update <Arrow /></a>
    </div>
  </section>
  <DocCards
    label="Documents"
    cards={[
      ...docs.map((doc) => ({
        href: doc.href,
        title: doc.index.data.title,
        summary: doc.index.data.summary,
        items: doc.pages.slice(1).map((p) => p.entry.data.title),
        more: `Open ${doc.index.data.title}`,
      })),
      {
        title: "Governance",
        summary: "How decisions about COD-AB are made, and by whom.",
        more: "Coming soon",
      },
    ]}
  />
</StandardsLayout>

<style>
  .request {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin: 2.5rem 0 -1rem;
    padding: 1.1rem 1.5rem;
    border-radius: var(--brand-radius);
    background: var(--brand-primary--lightest);
  }
  .request p {
    margin: 0;
    color: var(--cd-grey--900);
  }
  .request a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--brand-primary--text);
    font-weight: 700;
    text-decoration: none;
  }
  .request a:hover {
    text-decoration: underline;
  }
</style>
