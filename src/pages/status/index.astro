---
import InfoTable from "$lib/status/components/InfoTable.astro";
import ReviewOverview from "$lib/status/components/ReviewOverview.astro";
import { loadData } from "$lib/status/loadData";
import StatusLayout from "../../layouts/StatusLayout.astro";

const data = loadData();
const groups = data.planGroups.map((g) => ({
  ...g,
  countries: g.countries.filter((c) => c.inGis),
}));
---

<StatusLayout data={data}>
  <ReviewOverview planGroups={groups} page="info" />
  <InfoTable groups={groups} rows={data.infoRows} />
</StatusLayout>
