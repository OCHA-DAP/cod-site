---
import Summary from "$lib/status/components/Summary.astro";
import ReviewSection from "$lib/status/components/ReviewSection.astro";
import { loadData } from "$lib/status/loadData";
import StatusLayout from "../../layouts/StatusLayout.astro";

const data = loadData();
---

<StatusLayout data={data}>
  <Summary planGroups={data.planGroups} page="review" />
  <ReviewSection planGroups={data.planGroups} />
</StatusLayout>
