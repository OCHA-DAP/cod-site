---
import PipelineSummary from "$lib/status/components/PipelineSummary.astro";
import WorkOrdersSection from "$lib/status/components/WorkOrdersSection.astro";
import { loadData } from "$lib/status/loadData";
import StatusLayout from "../../layouts/StatusLayout.astro";

const data = loadData();
---

<StatusLayout data={data}>
  <PipelineSummary pipeline={data.pipeline} />
  <WorkOrdersSection workByQuarter={data.workByQuarter} open={data.openTotal} />
</StatusLayout>
